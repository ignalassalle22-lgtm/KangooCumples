{
  "framework": "vite",
  "buildCommand": "chmod -R +x node_modules/.bin && npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "regions": ["gru1"],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
